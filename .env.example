# Required for the Retell connector (text-mode and audio-mode).
RETELL_API_KEY=

# Required for the Vapi connector. Optional in v0.1 if you only use Retell.
VAPI_API_KEY=

# Required for the LLM judge, the persona simulator, and the KB Q/A generator.
OPENAI_API_KEY=

# Optional: pin a different judge model. Default is the snapshot below.
# VOXEVAL_JUDGE_MODEL=gpt-4o-mini-2024-07-18

# Optional: hard cost ceiling per `voxeval run` invocation (USD).
# VOXEVAL_MAX_COST_USD=0.50
