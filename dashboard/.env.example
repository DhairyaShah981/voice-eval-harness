# Supabase configuration. Copy to .env.local and fill in real values.
# When unset, the dashboard runs in "local mode" (uploads parse in browser, no persistence).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (legacy alias also supported)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by /api/runs ingest endpoint. NEVER expose to client.
# Either name works (new sb_secret_ format or legacy service_role JWT).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Bearer token clients must send to POST /api/runs.
RUNS_INGEST_TOKEN=change-me
